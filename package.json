{
  "name": "odin-rag-mcp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "uvicorn api.main:app --reload --host 0.0.0.0 --port 8001",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "lint": "npm --prefix apps/web run lint",
    "build:web": "npm --prefix apps/web run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
