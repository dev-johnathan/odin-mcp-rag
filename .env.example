# Retrieval / vector store
DEFAULT_PROVIDER=openai
EMBEDDINGS_PROVIDER=openai
INDEX_PATH=./data/index
MAX_CONTEXT_TOKENS=12000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8001
